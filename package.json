  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:test": "bash supabase/tests/run.sh",
    "brand:build": "python3 scripts/build_logo.py",
