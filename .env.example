# Copy to .env.local. Placeholders only — never commit real values.

# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY

# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY
# Long random string (e.g. `openssl rand -base64 32`). Signs order-page links. Changing it invalidates old links.
ORDER_LINK_SECRET=GENERATE_A_LONG_RANDOM_VALUE
# Add when Flutterwave is enabled:
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=
# Resend API key (https://resend.com). Leave blank to queue emails without sending.
EMAIL_PROVIDER_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM="GLAMS BY LEE <orders@YOUR-DOMAIN>"
